    "secondaryBorderColor": "#0f4d3a",
    "tertiaryColor": "#eef4f1",
    "tertiaryTextColor": "#0f4d3a",
    "tertiaryBorderColor": "#0f4d3a",
    "lineColor": "#0f4d3a",
    "textColor": "#0f4d3a",
    "titleColor": "#0f4d3a",
    "nodeTextColor": "#ffffff",
    "clusterBkg": "#eef4f1",
    "clusterBorder": "#0f4d3a",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#0f4d3a",
    "actorBorder": "#0f4d3a",
    "actorTextColor": "#ffffff",
    "actorLineColor": "#9fb8ad",
    "signalColor": "#0f4d3a",
    "signalTextColor": "#0f4d3a",
    "labelBoxBkgColor": "#eef4f1",
    "labelBoxBorderColor": "#0f4d3a",
    "labelTextColor": "#0f4d3a",
    "loopTextColor": "#0f4d3a",
