    "activationBorderColor": "#0f4d3a",
    "sequenceNumberColor": "#ffffff",
    "attributeBackgroundColorOdd": "#ffffff",
    "attributeBackgroundColorEven": "#eef4f1",
    "sectionBkgColor": "#eef4f1",
    "altSectionBkgColor": "#ffffff",
    "sectionBkgColor2": "#eef4f1",
    "taskBkgColor": "#0f4d3a",
    "taskBorderColor": "#0f4d3a",
    "taskTextColor": "#ffffff",
    "taskTextLightColor": "#ffffff",
    "taskTextOutsideColor": "#0f4d3a",
    "taskTextDarkColor": "#0f4d3a",
    "activeTaskBkgColor": "#2fbf71",
    "activeTaskBorderColor": "#0f4d3a",
    "doneTaskBkgColor": "#8a8f8c",
    "doneTaskBorderColor": "#8a8f8c",
