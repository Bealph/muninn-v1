  "themeCSS": ".node rect, .node polygon, .cluster rect { rx: 8px; ry: 8px; } .cluster-label, .cluster-label span { font-weight: 700; color: #0f4d3a !important; fill: #0f4d3a !important; } .edgeLabel, .edgeLabel p { color: #1f6b4f; font-style: italic; } .messageText { font-weight: 600; } .noteText, .noteText tspan { font-style: italic; } .actor { stroke-width: 0; } .row-rect-odd path, .row-rect-odd rect { fill: #eef4f1 !important; stroke: #c9dad2 !important; } .row-rect-even path, .row-rect-even rect { fill: #ffffff !important; stroke: #c9dad2 !important; } .label.attribute-type, .label.attribute-type *, .label.attribute-name, .label.attribute-name *, .label.attribute-keys, .label.attribute-keys *, .label.attribute-comment, .label.attribute-comment * { color: #0f4d3a !important; fill: #0f4d3a !important; } text.actor.actor-man, text.actor.actor-man tspan { fill: #0f4d3a !important; stroke: none !important; font-weight: 700 !important; }"
}
