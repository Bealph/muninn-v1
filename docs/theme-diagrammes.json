{
  "theme": "base",
  "flowchart": {
    "useMaxWidth": false,
    "curve": "step",
    "padding": 14,
    "nodeSpacing": 40,
    "rankSpacing": 50
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": false,
    "actorMargin": 60,
    "noteMargin": 12
  },
  "er": {
    "useMaxWidth": false
  },
  "gantt": {
    "useMaxWidth": false
  },
  "themeVariables": {
    "fontFamily": "'Segoe UI', 'DejaVu Sans', Arial, sans-serif",
