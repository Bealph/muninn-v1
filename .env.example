# Modèle du fichier .env : copier en .env, puis remplir. Le fichier .env n'est jamais versionné.
# Les valeurs ci-dessous ne servent qu'en local ; aucune n'est un vrai secret.

POSTGRES_USER=muninn
POSTGRES_PASSWORD=a-changer-en-local
POSTGRES_DB=muninn
DATABASE_URL=postgresql://muninn:a-changer-en-local@postgres:5432/muninn

# LLM (D-44, D-45). « faux » répond sans réseau ; « azure » appelle Azure AI Foundry.
LLM_FOURNISSEUR=faux
AZURE_AI_ENDPOINT=https://<ressource>.services.ai.azure.com
AZURE_AI_MODEL_A=gpt-5.4-mini
AZURE_AI_MODEL_B=mistral-medium-3-5
# Facultative. Vide : authentification Entra ID (az login en local, identité managée en Azure).
# Dans un conteneur local, sans az, la clé est nécessaire.
AZURE_AI_API_KEY=
